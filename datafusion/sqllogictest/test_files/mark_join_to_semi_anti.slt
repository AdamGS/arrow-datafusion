# Filtered projected markers become SEMI/ANTI joins. The marker is restored as
# a constant for ancestor consumers; false requires a two-valued (!null_aware)
# mark. Predicate spellings and schema edge cases are covered by unit tests.

statement ok
set datafusion.explain.logical_plan_only = true;

statement ok
CREATE TABLE pdm_outer(id BIGINT, k BIGINT) AS VALUES (1, 1), (2, 2), (3, 3), (4, NULL), (5, 2);

statement ok
CREATE TABLE pdm_inner(k BIGINT, g BIGINT) AS VALUES (2, 2), (2, 5), (NULL, 4);

statement ok
COPY (SELECT * FROM pdm_inner WHERE k IS NOT NULL)
TO 'test_files/scratch/mark_join_to_semi_anti/inner.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE pdm_inner_nn(k BIGINT NOT NULL, g BIGINT NOT NULL)
STORED AS PARQUET LOCATION 'test_files/scratch/mark_join_to_semi_anti/inner.parquet';

statement ok
CREATE VIEW pdm_exists AS
SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = o.k) AS m FROM pdm_outer o;

# Selecting the marker verifies its replacement constant and the alias schema.

query TT
EXPLAIN SELECT id, m FROM pdm_exists WHERE m;
----
logical_plan
01)SubqueryAlias: pdm_exists
02)--Projection: o.id, Boolean(true) AS m
03)----LeftSemi Join: o.k = __correlated_sq_1.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]

query IB rowsort
SELECT id, m FROM pdm_exists WHERE m;
----
2 true
5 true

query TT
EXPLAIN SELECT id, m FROM pdm_exists WHERE NOT m;
----
logical_plan
01)SubqueryAlias: pdm_exists
02)--Projection: o.id, Boolean(false) AS m
03)----LeftAnti Join: o.k = __correlated_sq_1.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]

query IB rowsort
SELECT id, m FROM pdm_exists WHERE NOT m;
----
1 false
3 false
4 false

# = ANY exposes a true-selecting conjunct on the first mark. The second mark
# still tracks UNKNOWN. Wrapped forms are covered in null_aware_mark_join.slt.

query TT
EXPLAIN SELECT id FROM pdm_outer WHERE k = ANY (SELECT k FROM pdm_inner);
----
logical_plan
01)Projection: pdm_outer.id
02)--LeftMark Join:  Filter: pdm_outer.k = __correlated_sq_2.k IS NULL
03)----LeftSemi Join:  Filter: pdm_outer.k = __correlated_sq_1.k IS TRUE
04)------TableScan: pdm_outer projection=[id, k]
05)------SubqueryAlias: __correlated_sq_1
06)--------TableScan: pdm_inner projection=[k]
07)----SubqueryAlias: __correlated_sq_2
08)------TableScan: pdm_inner projection=[k]

query I rowsort
SELECT id FROM pdm_outer WHERE k = ANY (SELECT k FROM pdm_inner);
----
2
5

# A null-aware negated mark must remain MARK: unmatched rows are UNKNOWN.

query TT
EXPLAIN SELECT id FROM pdm_outer WHERE (k NOT IN (SELECT k FROM pdm_inner)) IS TRUE;
----
logical_plan
01)Projection: pdm_outer.id
02)--Filter: NOT __correlated_sq_1.mark IS TRUE
03)----Projection: pdm_outer.id, __correlated_sq_1.mark
04)------LeftMark Join: pdm_outer.k = __correlated_sq_1.k null_aware
05)--------TableScan: pdm_outer projection=[id, k]
06)--------SubqueryAlias: __correlated_sq_1
07)----------TableScan: pdm_inner projection=[k]

query I rowsort
SELECT id FROM pdm_outer WHERE (k NOT IN (SELECT k FROM pdm_inner)) IS TRUE;
----


# Keep logical rewrites and physical NullsEqual, hash keys, and join selection.

statement ok
set datafusion.explain.logical_plan_only = false;

# NULL/NULL matches survive with nullable keys; a NOT NULL side allows ordinary equality.

query TT
EXPLAIN SELECT count(*) FROM (
  SELECT EXISTS (SELECT 1 FROM pdm_inner i WHERE o.k IS NOT DISTINCT FROM i.k) AS m
  FROM pdm_outer o
) t WHERE m;
----
logical_plan
01)Projection: count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[]], aggr=[[count(Int64(1))]]
03)----SubqueryAlias: t
04)------Projection:
05)--------LeftSemi Join: o.k = __correlated_sq_1.k
06)----------SubqueryAlias: o
07)------------TableScan: pdm_outer projection=[k]
08)----------SubqueryAlias: __correlated_sq_1
09)------------SubqueryAlias: i
10)--------------TableScan: pdm_inner projection=[k]
physical_plan
01)ProjectionExec: expr=[count(Int64(1))@0 as count(*)]
02)--AggregateExec: mode=Final, gby=[], aggr=[count(Int64(1))]
03)----CoalescePartitionsExec
04)------AggregateExec: mode=Partial, gby=[], aggr=[count(Int64(1))]
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)----------HashJoinExec: mode=CollectLeft, join_type=RightSemi, on=[(k@0, k@0)], projection=[], NullsEqual: true
07)------------DataSourceExec: partitions=1, partition_sizes=[1]
08)------------DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT count(*) FROM (
  SELECT EXISTS (SELECT 1 FROM pdm_inner i WHERE o.k IS NOT DISTINCT FROM i.k) AS m
  FROM pdm_outer o
) t WHERE m;
----
3

query TT
EXPLAIN SELECT count(*) FROM (
  SELECT EXISTS (SELECT 1 FROM pdm_inner_nn i WHERE o.k IS NOT DISTINCT FROM i.k) AS m
  FROM pdm_outer o
) t WHERE m;
----
logical_plan
01)Projection: count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[]], aggr=[[count(Int64(1))]]
03)----SubqueryAlias: t
04)------Projection:
05)--------LeftSemi Join: o.k = __correlated_sq_1.k
06)----------SubqueryAlias: o
07)------------TableScan: pdm_outer projection=[k]
08)----------SubqueryAlias: __correlated_sq_1
09)------------SubqueryAlias: i
10)--------------TableScan: pdm_inner_nn projection=[k]
physical_plan
01)ProjectionExec: expr=[count(Int64(1))@0 as count(*)]
02)--AggregateExec: mode=Final, gby=[], aggr=[count(Int64(1))]
03)----CoalescePartitionsExec
04)------AggregateExec: mode=Partial, gby=[], aggr=[count(Int64(1))]
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)----------HashJoinExec: mode=CollectLeft, join_type=RightSemi, on=[(k@0, k@0)], projection=[]
07)------------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/mark_join_to_semi_anti/inner.parquet]]}, projection=[k], file_type=parquet
08)------------DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT count(*) FROM (
  SELECT EXISTS (SELECT 1 FROM pdm_inner_nn i WHERE o.k IS NOT DISTINCT FROM i.k) AS m
  FROM pdm_outer o
) t WHERE m;
----
2

# An ordinary key plus a null-safe residual becomes two ordinary hash keys.

query TT
EXPLAIN SELECT count(*) FROM (
  SELECT EXISTS (
    SELECT 1 FROM pdm_inner_nn i WHERE o.id = i.g AND o.k IS NOT DISTINCT FROM i.k
  ) AS m FROM pdm_outer o
) t WHERE m;
----
logical_plan
01)Projection: count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[]], aggr=[[count(Int64(1))]]
03)----SubqueryAlias: t
04)------Projection:
05)--------LeftSemi Join: o.id = __correlated_sq_1.g, o.k = __correlated_sq_1.k
06)----------SubqueryAlias: o
07)------------TableScan: pdm_outer projection=[id, k]
08)----------SubqueryAlias: __correlated_sq_1
09)------------Projection: i.g, i.k
10)--------------SubqueryAlias: i
11)----------------TableScan: pdm_inner_nn projection=[k, g]
physical_plan
01)ProjectionExec: expr=[count(Int64(1))@0 as count(*)]
02)--AggregateExec: mode=Final, gby=[], aggr=[count(Int64(1))]
03)----CoalescePartitionsExec
04)------AggregateExec: mode=Partial, gby=[], aggr=[count(Int64(1))]
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)----------HashJoinExec: mode=CollectLeft, join_type=RightSemi, on=[(g@0, id@0), (k@1, k@1)], projection=[]
07)------------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/mark_join_to_semi_anti/inner.parquet]]}, projection=[g, k], file_type=parquet
08)------------DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT count(*) FROM (
  SELECT EXISTS (
    SELECT 1 FROM pdm_inner_nn i WHERE o.id = i.g AND o.k IS NOT DISTINCT FROM i.k
  ) AS m FROM pdm_outer o
) t WHERE m;
----
2

# Inequality correlations use NLJ; !null_aware also permits ANTI here.

query TT
EXPLAIN SELECT id FROM (
  SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS m FROM pdm_outer o
) t WHERE m;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----LeftSemi Join:  Filter: __correlated_sq_1.k < o.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]
physical_plan
01)NestedLoopJoinExec: join_type=RightSemi, filter=k@1 < k@0, projection=[id@0]
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT id FROM (
  SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS m FROM pdm_outer o
) t WHERE m;
----
3

query TT
EXPLAIN SELECT id FROM (
  SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS m FROM pdm_outer o
) t WHERE NOT m;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----LeftAnti Join:  Filter: __correlated_sq_1.k < o.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]
physical_plan
01)NestedLoopJoinExec: join_type=RightAnti, filter=k@1 < k@0, projection=[id@0]
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT id FROM (
  SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS m FROM pdm_outer o
) t WHERE NOT m;
----
1
2
4
5

# Conversion makes the SEMI join eligible for piecewise merge join.

statement ok
set datafusion.optimizer.enable_piecewise_merge_join = true;

query TT
EXPLAIN SELECT id FROM (
  SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS m FROM pdm_outer o
) t WHERE m;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----LeftSemi Join:  Filter: __correlated_sq_1.k < o.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]
physical_plan
01)ProjectionExec: expr=[id@0 as id]
02)--PiecewiseMergeJoin: operator=Gt, join_type=LeftSemi, on=(k > k)
03)----SortExec: expr=[k@1 ASC], preserve_partitioning=[false]
04)------DataSourceExec: partitions=1, partition_sizes=[1]
05)----DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT id FROM (
  SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS m FROM pdm_outer o
) t WHERE m;
----
3

# Filtering NULL join keys must still preserve the unmatched NULL row for ANTI.

statement ok
set datafusion.optimizer.filter_null_join_keys = true;

query IB rowsort
SELECT id, m FROM pdm_exists WHERE m;
----
2 true
5 true

query IB rowsort
SELECT id, m FROM pdm_exists WHERE NOT m;
----
1 false
3 false
4 false

statement ok
RESET datafusion.explain.logical_plan_only;

statement ok
RESET datafusion.optimizer.filter_null_join_keys;

statement ok
RESET datafusion.optimizer.enable_piecewise_merge_join;
